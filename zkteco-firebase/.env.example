# ──────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK — copy values from your service account JSON file
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=shop-dashboard-285a2
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@shop-dashboard-285a2.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40shop-dashboard-285a2.iam.gserviceaccount.com

# ──────────────────────────────────────────────────────────────────────────────
# Sync Mode
#   adms  — ZKTeco device pushes data to this server via HTTP (works on Render)
#   zklib — This server pulls data from the device via TCP (local network only)
# ──────────────────────────────────────────────────────────────────────────────
SYNC_MODE=adms

# ──────────────────────────────────────────────────────────────────────────────
# ZKTeco Device (required only when SYNC_MODE=zklib)
# ──────────────────────────────────────────────────────────────────────────────
DEVICE_IP=192.168.0.201
DEVICE_PORT=4370
DEVICE_SERIAL=BR63232460857

# ──────────────────────────────────────────────────────────────────────────────
# Attendance status thresholds
#   Check-in at or before WORK_START_HOUR:00          → Present (حاضر)
#   Check-in between WORK_START_HOUR+1 and LATE_CUTOFF_HOUR → Late (متأخر)
#   Check-in after LATE_CUTOFF_HOUR                   → Half Day (نصف يوم)
#   Work duration less than HALF_DAY_HOURS on checkout → Half Day (نصف يوم)
# ──────────────────────────────────────────────────────────────────────────────
WORK_START_HOUR=9
LATE_CUTOFF_HOUR=11
HALF_DAY_HOURS=4

# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
